# ImageKit (Frankfurt/EU processing region — set this in the ImageKit dashboard)
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/<your_imagekit_id>"

# Only needed if we add browser-based uploads later (signs upload requests
# server-side via getUploadAuthParams). Not used for displaying images.
# PUBLIC_IMAGEKIT_PUBLIC_KEY="<your_public_key>"
# IMAGEKIT_PRIVATE_KEY="<your_private_key>"
