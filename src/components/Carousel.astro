---
import { getResponsiveImageAttributes } from "@imagekit/javascript";
import type { Photo } from "../lib/feed";

interface Props {
	href: string;
	label: string;
	photos: Photo[];
	priority?: boolean;
}

const { href, label, photos, priority } = Astro.props;

const urlEndpoint = import.meta.env.IMAGEKIT_URL_ENDPOINT;

// Like Instagram, every slide takes the first photo's proportions so the
// carousel doesn't jump in height while swiping; the rest are cropped to fit.
const [first] = photos;
const aspectRatio = `${first.width} / ${first.height}`;

const slides = photos.map((photo) => ({
	...photo,
	...getResponsiveImageAttributes({
		src: photo.path,
		urlEndpoint,
		sizes: "(min-width: 36rem) 36rem, 100vw",
		deviceBreakpoints: [640, 828, 1080, 1280],
		imageBreakpoints: [],
	}),
}));

// Phosphor (regular): caret-left, caret-right.
const icons = {
	prev: "M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z",
	next: "M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z",
};
---

<div class="carousel group relative bleed">
	<ul
		class="carousel-track flex list-none snap-x snap-mandatory overflow-x-auto rounded-xl"
		style={{ aspectRatio }}
		aria-label={`${label}, ${photos.length} photos`}
	>
		{
			slides.map((slide, index) => (
				<li class="h-full w-full shrink-0 snap-start">
					<a href={href} class="block h-full" tabindex={index === 0 ? undefined : -1}>
						<img
							src={slide.src}
							srcset={slide.srcSet}
							sizes={slide.sizes}
							width={slide.width}
							height={slide.height}
							alt={slide.alt}
							loading={priority && index === 0 ? "eager" : "lazy"}
							fetchpriority={priority && index === 0 ? "high" : undefined}
							decoding="async"
							class="h-full w-full object-cover"
						/>
					</a>
				</li>
			))
		}
	</ul>

	{
		photos.length > 1 && (
			<>
				<button
					type="button"
					data-dir="-1"
					aria-label="Previous photo"
					class="carousel-button left-3"
				>
					<svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
						<path d={icons.prev} />
					</svg>
				</button>
				<button
					type="button"
					data-dir="1"
					aria-label="Next photo"
					class="carousel-button right-3"
				>
					<svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
						<path d={icons.next} />
					</svg>
				</button>
				<div class="carousel-dots" aria-hidden="true">
					{photos.map(() => <span />)}
				</div>
			</>
		)
	}
</div>

<style>
	.carousel-dots {
		position: absolute;
		inset-inline: 0;
		bottom: 0.75rem;
		display: flex;
		justify-content: center;
		gap: 0.375rem;
		pointer-events: none;
	}

	.carousel-dots span {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 9999px;
		background: white;
		opacity: 0.5;
		box-shadow: 0 0 2px rgb(0 0 0 / 0.4);
		transition: opacity 0.15s ease;
	}

	.carousel-dots span[data-active] {
		opacity: 1;
	}

	.carousel-track {
		scrollbar-width: none;
	}

	.carousel-track::-webkit-scrollbar {
		display: none;
	}

	/* Arrows are for mouse users only; touch screens just swipe. */
	.carousel-button {
		display: none;
	}

	@media (hover: hover) {
		.carousel-button {
			position: absolute;
			top: 50%;
			translate: 0 -50%;
			display: grid;
			place-items: center;
			width: 2rem;
			height: 2rem;
			border-radius: 9999px;
			background: rgb(255 255 255 / 0.85);
			color: var(--color-ink);
			opacity: 0;
			transition: opacity 0.15s ease;
			cursor: pointer;
		}

		.carousel:hover .carousel-button:not(:disabled),
		.carousel-button:focus-visible {
			opacity: 1;
		}
	}
</style>

<script>
	for (const carousel of document.querySelectorAll<HTMLElement>(".carousel")) {
		const track = carousel.querySelector<HTMLElement>(".carousel-track")!;
		const dots = carousel.querySelectorAll<HTMLElement>(".carousel-dots span");
		const [prev, next] = carousel.querySelectorAll<HTMLButtonElement>(".carousel-button");
		if (!prev || !next) continue;

		const update = () => {
			const index = Math.round(track.scrollLeft / track.clientWidth);
			dots.forEach((dot, i) => dot.toggleAttribute("data-active", i === index));
			prev.disabled = index === 0;
			next.disabled = index === track.children.length - 1;
		};

		for (const button of [prev, next]) {
			button.addEventListener("click", () => {
				track.scrollBy({ left: Number(button.dataset.dir) * track.clientWidth, behavior: "smooth" });
			});
		}

		track.addEventListener("scroll", update, { passive: true });
		update();
	}
</script>
