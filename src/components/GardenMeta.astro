---
import { formatDate } from "../lib/garden";
import StatusBadge from "./StatusBadge.astro";

interface Props {
	status: "seedling" | "budding" | "evergreen";
	createdAt: Date;
	updatedAt: Date;
}

const { status, createdAt, updatedAt } = Astro.props;

// Phosphor (regular): calendar-blank, clock-counter-clockwise.
const icons = {
	planted: "M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM72,48v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V80H48V48ZM208,208H48V96H208V208Z",
	tended: "M136,80v43.47l36.12,21.67a8,8,0,0,1-8.24,13.72l-40-24A8,8,0,0,1,120,128V80a8,8,0,0,1,16,0Zm-8-48A95.44,95.44,0,0,0,60.08,60.15C52.81,67.51,46.35,74.59,40,82V64a8,8,0,0,0-16,0v40a8,8,0,0,0,8,8H72a8,8,0,0,0,0-16H49c7.15-8.42,14.27-16.35,22.39-24.57a80,80,0,1,1,1.66,114.75,8,8,0,1,0-11,11.64A96,96,0,1,0,128,32Z",
};
---

<footer
	class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-1 border-t border-black/10 pt-4 text-sm text-muted dark:border-white/10 dark:text-muted-dark"
>
	<StatusBadge status={status} />
	<span class="inline-flex items-center gap-1.5">
		<svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
			<path d={icons.planted}></path>
		</svg>
		Planted {formatDate(createdAt)}
	</span>
	<span class="inline-flex items-center gap-1.5">
		<svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
			<path d={icons.tended}></path>
		</svg>
		Tended {formatDate(updatedAt)}
	</span>
</footer>
