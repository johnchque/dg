---
import { formatDate } from "../lib/garden";
import StatusBadge from "./StatusBadge.astro";

interface Props {
	status: "seedling" | "budding" | "evergreen";
	createdAt: Date;
	updatedAt: Date;
}

const { status, createdAt, updatedAt } = Astro.props;

// Remixicon: calendar-line, history-line.
const icons = {
	planted: "M9 1V3H15V1H17V3H21C21.5523 3 22 3.44772 22 4V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H7V1H9ZM20 11H4V19H20V11ZM7 5H4V9H20V5H17V7H15V5H9V7H7V5Z",
	tended: "M12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12H4C4 16.4183 7.58172 20 12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C9.25022 4 6.82447 5.38734 5.38451 7.50024L8 7.5V9.5H2V3.5H4L3.99989 5.99918C5.82434 3.57075 8.72873 2 12 2ZM13 7L12.9998 11.585L16.2426 14.8284L14.8284 16.2426L10.9998 12.413L11 7H13Z",
};
---

<footer
	class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-1 border-t border-black/10 pt-4 text-sm text-muted dark:border-white/10 dark:text-muted-dark"
>
	<StatusBadge status={status} />
	<span class="inline-flex items-center gap-1.5">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d={icons.planted}></path>
		</svg>
		Planted {formatDate(createdAt)}
	</span>
	<span class="inline-flex items-center gap-1.5">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d={icons.tended}></path>
		</svg>
		Tended {formatDate(updatedAt)}
	</span>
</footer>
