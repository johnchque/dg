---
import { formatDate } from "../lib/garden";
import StatusBadge from "./StatusBadge.astro";

interface Props {
	status: "seedling" | "budding" | "evergreen";
	updatedAt: Date;
}

const { status, updatedAt } = Astro.props;
---

<p
	class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted dark:text-muted-dark"
>
	<StatusBadge status={status} />
	<span aria-hidden="true">·</span>
	<span>Tended {formatDate(updatedAt)}</span>
</p>
