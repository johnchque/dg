const labels: Record<Props["status"], string> = {
	seedling: "Seedling",
	budding: "Budding",
	evergreen: "Evergreen",
};

const titles: Record<Props["status"], string> = {
	seedling: "An early, rough idea — likely to change a lot.",
	budding: "Has some structure, but still growing.",
	evergreen: "Mature and actively maintained.",
