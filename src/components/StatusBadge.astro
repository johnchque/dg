<span
	class="inline-flex align-middle items-center gap-1 text-sm"
	title={describe ? undefined : titles[status]}
>
	<svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
		<path d={icons[status]}></path>
	</svg>
	{showLabel && labels[status]}
