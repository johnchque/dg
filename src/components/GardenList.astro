---
import GardenItem from "./GardenItem.astro";
import type { GardenEntry } from "../lib/garden";

interface Props {
	entries: GardenEntry[];
}

const { entries } = Astro.props;

const byYear = new Map<number, GardenEntry[]>();
for (const entry of entries) {
	const year = entry.updatedAt.getFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), entry]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

{
	years.map((year) => (
		<section class="mb-3">
			<h3 class="mb-1 text-sm text-muted dark:text-muted-dark">{year}</h3>
			<ul class="list-none">
				{byYear.get(year)!.map((entry) => (
					<GardenItem entry={entry} />
				))}
			</ul>
		</section>
	))
}
