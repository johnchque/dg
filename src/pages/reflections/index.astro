---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StatusBadge from "../../components/StatusBadge.astro";

const reflections = await getCollection("reflections");
reflections.sort(
	(a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf(),
);
---

<Layout
	title="Reflections"
	description="Things I've been thinking about, written down as they come."
>
	<h1 class="mb-6">Reflections</h1>
	<ul class="list-none space-y-3">
		{
			reflections.map((reflection) => (
				<li>
					<a
						href={`/reflections/${reflection.id}/`}
						class="link"
					>
						{reflection.data.title}
					</a>
					<span class="ml-2 text-muted dark:text-muted-dark">
						<StatusBadge status={reflection.data.status} />
					</span>
				</li>
			))
		}
	</ul>
</Layout>
