---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import AlbumPost from "../components/AlbumPost.astro";
import { ogImageUrl } from "../lib/imagekit";

const albums = await getCollection("albums");
albums.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = (
	await Promise.all(
		albums.map(async (album) => {
			const { remarkPluginFrontmatter } = await render(album);
			const photos = (remarkPluginFrontmatter.photos ?? []) as Array<{
				path: string;
				alt: string;
				width: number;
				height: number;
			}>;
			return {
				href: `/albums/${album.id}/`,
				title: album.data.title,
				date: album.data.date,
				photos,
			};
		}),
	)
).filter((post) => post.photos.length > 0);

const ogImage = posts[0] ? ogImageUrl(posts[0].photos[0].path) : undefined;
---

<Layout
	title="Photos"
	description="A chronological stream of photos from my albums."
	image={ogImage}
>
	<h1 class="mb-6">Photos</h1>
	{posts.map((post, index) => <AlbumPost {...post} priority={index === 0} />)}
</Layout>
