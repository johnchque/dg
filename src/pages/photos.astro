---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PhotoCard from "../components/PhotoCard.astro";
import { ogImageUrl } from "../lib/imagekit";

const albums = await getCollection("albums");

const photos = albums.flatMap((album) =>
	album.data.photos.map((photo) => ({
		...photo,
		date: album.data.date,
		albumSlug: album.id,
		albumTitle: album.data.title,
	})),
);
photos.sort((a, b) => b.date.valueOf() - a.date.valueOf());

const ogImage = photos[0] ? ogImageUrl(photos[0].path) : undefined;
---

<Layout
	title="Photos"
	description="A chronological stream of photos from my albums."
	image={ogImage}
>
	<h1 class="font-bold text-xl mb-6">Photos</h1>
	{
		photos.map((photo, index) => (
			<PhotoCard
				src={photo.path}
				alt={photo.alt}
				caption={photo.caption}
				width={photo.width}
				height={photo.height}
				priority={index === 0}
			/>
		))
	}
</Layout>
