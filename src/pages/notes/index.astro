---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StatusBadge from "../../components/StatusBadge.astro";

const notes = await getCollection("notes");
notes.sort(
	(a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf(),
);
---

<Layout
	title="Notes"
	description="Loose notes on things I don't entirely understand yet."
>
	<h1 class="mb-6">Notes</h1>
	<ul class="list-none space-y-3">
		{
			notes.map((note) => (
				<li>
					<a
						href={`/notes/${note.id}/`}
						class="link"
					>
						{note.data.title}
					</a>
					<span class="ml-2 text-muted dark:text-muted-dark">
						<StatusBadge status={note.data.status} />
					</span>
				</li>
			))
		}
	</ul>
</Layout>
