---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StatusBadge from "../../components/StatusBadge.astro";

const essays = await getCollection("essays");
essays.sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
---

<Layout
	title="Essays"
	description="Writing about what I believe, published as it develops."
>
	<h1 class="font-bold text-xl mb-6">Essays</h1>
	<ul class="list-none space-y-3">
		{
			essays.map((essay) => (
				<li>
					<a
						href={`/essays/${essay.id}/`}
						class="link"
					>
						{essay.data.title}
					</a>
					<span class="ml-2">
						<StatusBadge status={essay.data.status} />
					</span>
				</li>
			))
		}
	</ul>
</Layout>
