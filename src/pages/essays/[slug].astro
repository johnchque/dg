---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import GardenMeta from "../../components/GardenMeta.astro";

export async function getStaticPaths() {
	const essays = await getCollection("essays");
	return essays.map((essay) => ({
		params: { slug: essay.id },
		props: { essay },
	}));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<Layout
	title={essay.data.title}
	description={essay.data.description ?? `An essay: ${essay.data.title}.`}
>
	<GardenMeta
		status={essay.data.status}
		updatedAt={essay.data.updatedAt}
	/>
	<h1 class="mb-16">{essay.data.title}</h1>
	<div class="post-content">
		<Content />
	</div>
</Layout>
