---
import Layout from "../../layouts/Layout.astro";
import GardenList from "../../components/GardenList.astro";
import { getGardenEntries } from "../../lib/garden";

const gardenEntries = await getGardenEntries();
---

<Layout
	title="Garden"
	description="Essays, explorations, and reflections, sorted by when they were last touched — published as they grow, not once they're finished."
>
	<h1 class="mb-6">Garden</h1>
	<GardenList entries={gardenEntries} />
</Layout>
