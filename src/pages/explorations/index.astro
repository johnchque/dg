---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StatusBadge from "../../components/StatusBadge.astro";

const explorations = await getCollection("explorations");
explorations.sort(
	(a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf(),
);
---

<Layout
	title="Explorations"
	description="Notes from learning something in depth, published as I go."
>
	<h1 class="font-bold text-xl mb-6">Explorations</h1>
	<ul class="list-none space-y-3">
		{
			explorations.map((exploration) => (
				<li>
					<a
						href={`/explorations/${exploration.id}/`}
						class="link"
					>
						{exploration.data.title}
					</a>
					<span class="ml-2">
						<StatusBadge status={exploration.data.status} />
					</span>
				</li>
			))
		}
	</ul>
</Layout>
