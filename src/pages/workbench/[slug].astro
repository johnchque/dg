---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatType, getProjects, hasPage } from "../../lib/workbench";
import { ogImageUrl } from "../../lib/imagekit";

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.filter(hasPage).map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(project);

const firstPhoto = remarkPluginFrontmatter.photos?.[0];
const ogImage = firstPhoto ? ogImageUrl(firstPhoto.path) : undefined;

const { title, description, type, role, date } = project.data;
const facts = [
	["Type", formatType(type)],
	["Role", role],
	["Year", String(date.getFullYear())],
];
---

<Layout title={title} description={description} image={ogImage}>
	<a
		href="/workbench/"
		class="group relative mb-6 inline-block text-sm text-muted hover:text-evening dark:text-muted-dark dark:hover:text-sunset"
	>
		{/* On hover the label slides right and the arrow fades in where it was. */}
		<span
			aria-hidden="true"
			class="absolute left-0 -translate-x-1 opacity-0 transition duration-200 ease-out group-hover:translate-x-0 group-hover:opacity-100 motion-reduce:transition-none"
			>←</span
		>
		<span
			class="inline-block transition-transform duration-200 ease-out group-hover:translate-x-4 motion-reduce:transition-none"
			>Workbench</span
		>
	</a>
	<h1 class="mb-3">{title}</h1>
	<p class="mb-8 text-muted dark:text-muted-dark">{description}</p>
	{/* Label and value side by side, one fact per row, like a film's credits. */}
	<dl class="mb-12 grid grid-cols-[5rem_1fr] gap-y-1.5 text-sm">
		{
			facts.map(([label, value]) => (
				<>
					<dt class="text-muted dark:text-muted-dark">{label}</dt>
					<dd>{value}</dd>
				</>
			))
		}
	</dl>
	<div class="post-content">
		<Content />
	</div>
</Layout>

