---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatType, getProjects, hasPage } from "../../lib/workbench";
import { ogImageUrl } from "../../lib/imagekit";

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.filter(hasPage).map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(project);

const firstPhoto = remarkPluginFrontmatter.photos?.[0];
const ogImage = firstPhoto ? ogImageUrl(firstPhoto.path) : undefined;

const { title, description, type, role, date } = project.data;
const facts = [
	["Type", formatType(type)],
	["Role", role],
	["Year", String(date.getFullYear())],
];
---

<Layout title={title} description={description} image={ogImage}>
	<a
		href="/workbench/"
		class="mb-6 inline-block text-sm text-muted hover:text-evening dark:text-muted-dark dark:hover:text-sunset"
	>
		← Workbench
	</a>
	<h1 class="mb-3">{title}</h1>
	<p class="mb-8 text-muted dark:text-muted-dark">{description}</p>
	<dl
		class="mb-16 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-black/10 py-4 sm:grid-flow-col sm:grid-cols-none dark:border-white/10"
	>
		{
			facts.map(([label, value]) => (
				<div>
					<dt class="mb-1 text-xs text-muted dark:text-muted-dark">{label}</dt>
					<dd class="text-sm">{value}</dd>
				</div>
			))
		}
	</dl>
	<div class="post-content">
		<Content />
	</div>
</Layout>
