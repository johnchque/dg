---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const albums = await getCollection("albums");
albums.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof albums>();
for (const album of albums) {
	const year = album.data.date.getFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), album]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Layout title="Albums" description="Photo albums, organized by year.">
	<h1 class="mb-6">Albums</h1>
	{
		years.map((year) => (
			<section class="mb-6">
				<h2 class="mb-2">{year}</h2>
				<ul class="list-none space-y-1">
					{byYear.get(year)!.map((album) => (
						<li>
							<a
								href={`/albums/${album.id}/`}
								class="link"
							>
								{album.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Layout>
