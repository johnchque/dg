const description =
	"Software Engineer and Social Entrepreneur working on AI ethics, data sovereignty, and a post-extractive web. Also: photos, guitar, and bouldering.";
---

<Layout description={description}>
	<section class="post-content">
		<!-- <h1 class="font-bold">John Choque</h1> -->
		<!-- <p class="text-gray-400">Software Engineer and Social Entrepreneur</p> -->
		<p>
			I am in a continuous journey to learn how to build meaningful tech.
			I care deeply about AI ethics, data sovereignty, digital inclusion,
			edTech, and building a post-extractive web.
		</p>
		<p>
			I am currently a Frontend Engineer at
			{" "}<a
				href="https://www.livahealthcare.com/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-evening underline hover:text-evening-dark dark:text-sunset dark:hover:text-sunset-light"
				>Liva Healthcare</a
			>. Prior to this role, I co-founded multiple organizations and
			startups, and volunteered with several mission-driven initiatives.
		</p>
		<!-- <p>
			Beyond work, I like to travel and take photos, play the guitar, and
			do bouldering.
		</p> -->
	</section>
