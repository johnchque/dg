---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const siteName = "John Choque";
const defaultDescription =
	"John Choque — Software Engineer and Social Entrepreneur. Photos, albums, and writing.";

const {
	title,
	description = defaultDescription,
	image = "/og-default.png",
} = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				const stored = localStorage.getItem("theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				if (stored === "dark" || (!stored && prefersDark)) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<Font cssVariable="--font-open-sans" preload />
		<Font cssVariable="--font-literata" preload />
	</head>
	<body
		class="bg-mist text-ink transition-colors duration-700 ease-in-out dark:bg-charcoal dark:text-chalk"
	>
		<header
			class="fixed inset-x-0 top-0 z-10 flex max-w-4xl items-start justify-between p-4 md:p-6 lg:p-8"
		>
			<div>
				<a href="/">John Choque</a>
				<p class="text-muted dark:text-muted-dark">
					Building meaninfgul tech
				</p>
			</div>
			<nav class="flex flex-col items-end gap-1">
				<!-- <a
					href="/photos/"
					class="underline hover:text-evening dark:hover:text-sunset"
					>Photos</a
				>
				<a
					href="/albums/"
					class="underline hover:text-evening dark:hover:text-sunset"
					>Albums</a
				> -->
				<button
					id="theme-toggle"
					type="button"
					aria-label="Toggle color theme"
					class="mt-1 grid size-4 place-items-center self-end hover:text-evening dark:hover:text-sunset"
				>
					<svg
						class="col-start-1 row-start-1 dark:hidden"
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 256 256"
						fill="currentColor"
						><path
							d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"
						></path></svg
					>
					<svg
						class="col-start-1 row-start-1 hidden dark:inline"
						width="16"
						height="16"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 256 256"
						fill="currentColor"
						><path
							d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"
						></path></svg
					>
				</button>
			</nav>
		</header>
		<main class="max-w-2xl p-4 pt-28 md:p-6 md:pt-28 lg:p-8 lg:pt-32">
			<slot />
		</main>
		<script is:inline>
			document
				.getElementById("theme-toggle")
				?.addEventListener("click", () => {
					const isDark =
						document.documentElement.classList.toggle("dark");
					localStorage.setItem("theme", isDark ? "dark" : "light");
				});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		body {
			transition: none;
		}
	}
</style>
